# ============================================
# AI Job Interview Booster — API Key Setup
# ============================================
# You only need ONE of these. Pick your preferred AI provider:

# Option 1: OpenAI (easiest to set up)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option 2: Anthropic Claude (best quality output)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option 3: Free local AI (no key needed)
# Install Ollama: https://ollama.ai
# Then run: ollama pull llama3
# Leave both keys above blank to use Ollama

# Optional: Override the default model
# MODEL=gpt-4o-mini
